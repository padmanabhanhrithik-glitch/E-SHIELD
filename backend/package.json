{
  "name": "eshield-backend",
  "version": "1.0.0",
  "description": "E-SHIELD backend — receives ESP32 telemetry (HTTP + MQTT), validates it, writes to Firebase, generates alerts, and broadcasts real-time updates over Socket.IO.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.3.1",
    "helmet": "^7.1.0",
    "mqtt": "^5.10.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
