PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://127.0.0.1:8081

# Firebase Admin SDK — fill these from the NEW Firebase project's service account.
# NEVER put these values in the frontend or ESP32 firmware.
FIREBASE_PROJECT_ID=faultsentinel
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# HTTP is the primary ESP32 transport. MQTT is disabled unless explicitly enabled.
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_TELEMETRY=eshield/+/telemetry
MQTT_TOPIC_STATUS=eshield/+/status

# Shared secret between ESP32 and backend. Create your own value locally.
DEVICE_INGEST_SECRET=CHANGE_ME_TO_A_RANDOM_DEVICE_SECRET
DEVICE_OFFLINE_TIMEOUT_MS=15000

ESHIELD_MODE=LIVE
ML_INFERENCE_URL=http://127.0.0.1:5001
CLASSIFICATION_CONFIDENCE_THRESHOLD=
CLASSIFICATION_MARGIN=
LEARNING_SECONDS=60
ANOMALY_Z_THRESHOLD=3.5
ANOMALY_CONSECUTIVE=2
SAFETY_MAX_POWER_W=3000
