# Firebase Web App config for project: faultsentinel
# Get these from Firebase Console -> Project settings -> Your apps -> Web app.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=faultsentinel.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=faultsentinel
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mac's LAN IP address where the backend runs.
# Example: http://192.168.1.50:4000
EXPO_PUBLIC_BACKEND_URL=http://YOUR_MAC_LAN_IP:4000
